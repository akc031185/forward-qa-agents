# ── Model policy: open-weight, locally-run models only (DeepSeek, Kimi, Qwen…). No paid APIs. ──
# auto (default) = probe local Ollama → local OpenAI-compatible server (llama.cpp / vLLM / LM Studio) → none
LLM_PROVIDER=auto             # auto | none | ollama | openai-compatible
LLM_MODEL=deepseek-r1:8b      # see docs/models.md for the tested list
LLM_BASE_URL=                 # blank = defaults (Ollama http://127.0.0.1:11434, llama.cpp http://127.0.0.1:8080)
LLM_ALLOW_REMOTE=0            # 1 only for a self-hosted server on your own network

DB_PATH=./data/forward-qa.db
PORT=8787
WORKSPACE_DIR=./workspace

# ── Client-facing report branding (optional) ───────────────────────────────────
# Used by The AI Site Auditor's report footer. Left blank, the report is unbranded
# and omits any link that is not set. Kept out of the repo on purpose: no real
# company or product name belongs in source, fixtures or docs.
BRAND_COMPANY=                # e.g. "Acme Studio"
BRAND_TAGLINE=                # one line under the company name
BRAND_SITE_URL=               # https://example.com
BRAND_ACCOUNT_URL=            # where a client manages their account
BRAND_BILLING_URL=            # where a client sees invoices and plan
BRAND_DASHBOARD_URL=          # where a client submits more sites and sees past audits
BRAND_CONTACT_EMAIL=          # shown as "questions about this report"
